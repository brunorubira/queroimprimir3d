generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PROVIDER
  ADMIN
}

enum RequestStatus {
  OPEN
  MATCHING
  CLOSED
  CANCELLED
}

enum ProposalStatus {
  SENT
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum OrderStatus {
  CREATED
  IN_PROGRESS
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  role          Role      @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  provider      Provider?
  requests      Request[]
  conversations ConversationParticipant[]
  messages      Message[]
  reviews       Review[]  @relation("ReceivedReviews")
  givenReviews  Review[]  @relation("GivenReviews")
  notifications Notification[]
}

model Provider {
  id          String   @id @default(uuid())
  bio         String?
  rating      Float    @default(0)
  isVerified  Boolean  @default(false)
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  
  printers    Printer[]
  services    Service[]
  proposals   Proposal[]
  boosts      Boost[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Printer {
  id          String   @id @default(uuid())
  model       String
  technology  String
  buildVolume String?
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id])
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id])
}

model Request {
  id          String        @id @default(uuid())
  title       String
  description String
  status      RequestStatus @default(OPEN)
  clientId    String
  client      User          @relation(fields: [clientId], references: [id])
  
  attachments Attachment[]
  proposals   Proposal[]
  order       Order?
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Attachment {
  id        String   @id @default(uuid())
  url       String
  filename  String
  mimetype  String
  requestId String
  request   Request  @relation(fields: [requestId], references: [id])
}

model Proposal {
  id          String         @id @default(uuid())
  price       Float
  deliveryDays Int
  description String
  status      ProposalStatus @default(SENT)
  
  requestId   String
  request     Request        @relation(fields: [requestId], references: [id])
  
  providerId  String
  provider    Provider       @relation(fields: [providerId], references: [id])
  
  order       Order?
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Order {
  id          String      @id @default(uuid())
  status      OrderStatus @default(CREATED)
  
  requestId   String      @unique
  request     Request     @relation(fields: [requestId], references: [id])
  
  proposalId  String      @unique
  proposal    Proposal    @relation(fields: [proposalId], references: [id])
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Conversation {
  id           String                    @id @default(uuid())
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now())
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
}

model Message {
  id             String       @id @default(uuid())
  content        String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  createdAt      DateTime     @default(now())
}

model Review {
  id          String   @id @default(uuid())
  rating      Int
  comment     String?
  
  targetId    String
  target      User     @relation("ReceivedReviews", fields: [targetId], references: [id])
  
  authorId    String
  author      User     @relation("GivenReviews", fields: [authorId], references: [id])
  
  createdAt   DateTime @default(now())
}

model Boost {
  id          String   @id @default(uuid())
  startDate   DateTime @default(now())
  endDate     DateTime
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  isRead    Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
